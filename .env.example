# Borderless — environment template.
# Copy to .env.local (git-ignored):  cp .env.example .env.local
# Then run `pnpm wallets:setup`, which generates, funds and fills in every wallet value below
# on Stellar TESTNET. You should not need to paste any keys by hand.

# ── App ──────────────────────────────────────────────────────────────────────
DATABASE_URL=file:./data/borderless.db
# Where the agent reaches the provider endpoints. Leave unset: it defaults to this server's
# own port (http://localhost:$PORT). Set it only for CLI scripts or a custom host, e.g.
#   APP_BASE_URL=http://localhost:3001 pnpm demo:agent
# APP_BASE_URL=

# ── Stellar (testnet only; any other network is rejected at startup) ────────
STELLAR_NETWORK=stellar:testnet
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_EXPLORER_TX_URL=https://stellar.expert/explorer/testnet/tx

# ── x402 facilitator ─────────────────────────────────────────────────────────
# Public facilitator; supports `exact` on stellar:testnet with sponsored fees; no key needed.
X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_FACILITATOR_API_KEY=

# ── Demo pricing ─────────────────────────────────────────────────────────────
# NGN of simulated household value per 1 testnet USDC. A fixed demo setting, NOT an exchange rate.
DEMO_NGN_PER_TESTNET_USDC=100000

# ── AI planner ───────────────────────────────────────────────────────────────
# Server-only. Without a key, Borderless runs its deterministic planner (no AI).
# Gemini is used when GEMINI_API_KEY is set (via Google's OpenAI-compatible endpoint);
# otherwise OpenAI. Force one with AI_PROVIDER=gemini|openai.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# AI_PROVIDER=gemini
# AGENT_REASONING_EFFORT=low          # minimal | low | medium | high
# AGENT_MAX_STEPS=18                  # tool-call steps per run before stopping
# AGENT_RUN_TIMEOUT_SECONDS=300       # whole-run time limit
# AGENT_MODEL_TIMEOUT_SECONDS=60      # per model call

# ── Wallets (filled in by `pnpm wallets:setup`) ──────────────────────────────
# Agent payer: signs x402 payments. Server-only; never sent to the browser.
AGENT_STELLAR_SECRET=
AGENT_STELLAR_PUBLIC=
# Funding guard: household treasury that grants the agent wallet a capped, expiring
# on-chain allowance (testnet, generated by wallets:setup). The secret is demo-only.
TREASURY_STELLAR_PUBLIC=
TREASURY_STELLAR_SECRET=
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
FUNDING_GUARD_FLOAT_TARGET_USDC=1
# Empty testnet wallet for the "empty wallet" demo scenario (generated by wallets:setup).
DEMO_EMPTY_WALLET_PUBLIC=
DEMO_EMPTY_WALLET_SECRET=
# Provider receiving addresses (public keys).
PROVIDER_ELECTRICITY_PAYTO=
PROVIDER_AIRTIME_PAYTO=
PROVIDER_DATA_PAYTO=
PROVIDER_POWERGRID_PAYTO=
PROVIDER_TOPUPHUB_PAYTO=
PROVIDER_DATALINK_PAYTO=
# Provider secrets are kept only so trustlines can be restored after a testnet reset.
# The running app never reads them.
PROVIDER_ELECTRICITY_SECRET=
PROVIDER_AIRTIME_SECRET=
PROVIDER_DATA_SECRET=
PROVIDER_POWERGRID_SECRET=
PROVIDER_TOPUPHUB_SECRET=
PROVIDER_DATALINK_SECRET=
