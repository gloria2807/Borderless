# Borderless — environment template. Copy to .env.local (git-ignored).
# `pnpm wallets:setup` generates and funds all wallet values below automatically on Stellar TESTNET.

# App
# APP_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3001 pnpm demo:providers
DATABASE_URL=file:./data/borderless.db

# Stellar (testnet only — mainnet is rejected by config validation)
STELLAR_NETWORK=stellar:testnet
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# x402 facilitator (public Coinbase-operated facilitator; fees sponsored on testnet, no key needed)
X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_FACILITATOR_API_KEY=

# Demo pricing: NGN of simulated value per 1 testnet USDC. A fixed demo setting, NOT an exchange rate.
DEMO_NGN_PER_TESTNET_USDC=100000

# Agent payer wallet (server-only; never exposed to the browser)
AGENT_STELLAR_SECRET=
AGENT_STELLAR_PUBLIC=

# Provider receiving wallets (public keys; secrets kept only so trustlines can be restored after a testnet reset)
PROVIDER_ELECTRICITY_PAYTO=
PROVIDER_AIRTIME_PAYTO=
PROVIDER_DATA_PAYTO=
PROVIDER_ELECTRICITY_SECRET=
PROVIDER_AIRTIME_SECRET=
PROVIDER_DATA_SECRET=
